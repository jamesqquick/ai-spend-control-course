[
	{
		"id": "start",
		"type": "start",
		"outputs": { "next": { "elementId": "is_bot" } }
	},
	{
		"id": "is_bot",
		"type": "conditional",
		"properties": {
			"conditions": { "metadata.user_type": { "$eq": "bot" } }
		},
		"outputs": {
			"true": { "elementId": "bot_budget" },
			"false": { "elementId": "is_free" }
		}
	},
	{
		"id": "bot_budget",
		"type": "rate",
		"properties": {
			"limitType": "count",
			"key": "metadata.user_type",
			"limit": 3,
			"window": 3600
		},
		"outputs": {
			"success": { "elementId": "higher_cost" },
			"fallback": { "elementId": "lower_cost" }
		}
	},
	{
		"id": "is_free",
		"type": "conditional",
		"properties": {
			"conditions": { "metadata.user_type": { "$eq": "free" } }
		},
		"outputs": {
			"true": { "elementId": "lower_cost" },
			"false": { "elementId": "higher_cost" }
		}
	},
	{
		"id": "lower_cost",
		"type": "model",
		"properties": {
			"provider": "workers-ai",
			"model": "@cf/openai/gpt-oss-20b",
			"timeout": 30000,
			"retries": 0
		},
		"outputs": {
			"success": { "elementId": "end" },
			"fallback": { "elementId": "end" }
		}
	},
	{
		"id": "higher_cost",
		"type": "model",
		"properties": {
			"provider": "workers-ai",
			"model": "@cf/openai/gpt-oss-120b",
			"timeout": 60000,
			"retries": 0
		},
		"outputs": {
			"success": { "elementId": "end" },
			"fallback": { "elementId": "backup" }
		}
	},
	{
		"id": "backup",
		"type": "model",
		"properties": {
			"provider": "workers-ai",
			"model": "@cf/openai/gpt-oss-20b",
			"timeout": 60000,
			"retries": 0
		},
		"outputs": {
			"success": { "elementId": "end" },
			"fallback": { "elementId": "end" }
		}
	},
	{ "id": "end", "type": "end", "outputs": {} }
]
